# ── Domains (production deploy via docker-compose + Caddy) ────────────
# Không có domain riêng? Dùng nip.io: thay <IP> bằng IP công khai của VPS,
# ví dụ VPS 123.45.67.89 ->  WEB_DOMAIN=pos.123.45.67.89.nip.io
WEB_DOMAIN=pos.<IP>.nip.io
API_DOMAIN=api.<IP>.nip.io
# Email cho chứng chỉ Let's Encrypt (nên đặt; có thể để trống)
ACME_EMAIL=

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=restai
POSTGRES_PASSWORD=change-me-in-production

# ── API Server ────────────────────────────────────────────────────────
API_PORT=3001
# Sinh secret mạnh: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
LOG_LEVEL=info
# (Khi deploy bằng docker-compose, CORS tự = https://${WEB_DOMAIN}, KHÔNG cần đặt ở đây.
#  Biến này chỉ dùng khi chạy API ngoài Docker.)
# CORS_ORIGINS=http://localhost:3000

# ── Database (composed automatically in docker-compose) ───────────────
# Only needed when running outside Docker:
# DATABASE_URL=postgresql://restai:change-me-in-production@localhost:5432/restai

# ── Redis (hardcoded in docker-compose as redis://redis:6379) ─────────
# Only needed when running outside Docker:
# REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 Storage ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=toda-pos
R2_PUBLIC_URL=

# OpenAI GPT Image (tao anh san pham tu ten mon)
OPENAI_API_KEY=
GPT_IMAGE_MODEL=gpt-image-1
GPT_IMAGE_SIZE=1024x1024
GPT_IMAGE_QUALITY=medium
# Fal.ai duoc uu tien neu co FAL_KEY
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/gpt-image-2
FAL_IMAGE_SIZE=square_hd
FAL_IMAGE_QUALITY=medium
FAL_IMAGE_TIMEOUT_MS=180000
# Neu khong cau hinh R2, API se luu anh AI vao thu muc nay va web phuc vu /uploads
LOCAL_UPLOAD_DIR=apps/web/public/uploads
PUBLIC_UPLOAD_URL=/uploads

# ── Cổng thanh toán ──────────────────────────────────────────────────
# Địa chỉ CÔNG KHAI của API — MoMo phải gọi ngược vào được để báo tiền đã về,
# nên không dùng được localhost hay tên service nội bộ trong docker.
# Khi deploy bằng docker-compose, hai biến này tự sinh từ API_DOMAIN/WEB_DOMAIN.
# PUBLIC_API_URL=https://api.<IP>.nip.io
# PUBLIC_WEB_URL=https://pos.<IP>.nip.io
#
# Khóa MoMo (partnerCode/accessKey/secretKey) KHÔNG đặt ở đây — mỗi chi nhánh
# một hợp đồng riêng nên khóa lưu trong DB, nhập qua Cài đặt → Chi nhánh.

# ── Web App (build-time, nướng vào client bundle) ────────────────────
# Khi deploy bằng docker-compose, web tự build với https://${API_DOMAIN} +
# wss://${API_DOMAIN}, KHÔNG cần đặt ở đây. Hai biến dưới chỉ dùng cho dev local
# (đặt trong apps/web/.env):
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
